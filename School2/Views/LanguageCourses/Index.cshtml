@model IEnumerable<School2.Models.LanguageCourses.LanguageCourseViewModel>
@{
    int rowNumber = 1;
}

@* Later check for role of the user, hide this button if not admin or teacher *@
<div>
    <a asp-action="Create" asp-controller="LanguageCourses" type="submit" class="btn btn-dark">
        Lisa uus keelekursus
    </a>
</div>

<div class="h1">
    Keelekursused
</div>
<form method="get">
    <table class="table table-hover"> 
        <thead> 
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Nimetus</th>
                <th scope="col">Õpetaja keel</th>
                <th scope="col">Tegevused</th>
            </tr> 
        </thead> 
        <tbody> 
            @foreach (var course in Model) 
            { 
                <tr> 
                    <td>@rowNumber</td> 
                    <td>@course.Nimetus</td> 
                    <td>@course.Keel</td> 
                    <td> 
                        <a asp-action="Details" asp-controller="LanguageCourses" asp-route-id="@course.Id" class="btn btn-secondary">Andmed</a> 
                        <a asp-action="Update" asp-controller="LanguageCourses" asp-route-id="@course.Id" class="btn btn-warning">Muuda</a> 
                        <a asp-action="Delete" asp-controller="LanguageCourses" asp-route-id="@course.Id" class="btn btn-danger">Kustuta</a> 
                    </td> 
                </tr> 

                rowNumber++;
            } 
        </tbody> 
    </table>
</form>