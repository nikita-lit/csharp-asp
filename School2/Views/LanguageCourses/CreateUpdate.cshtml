@model School2.Models.LanguageCourses.LanguageCourseCreateUpdateViewModel

@* seperate update create *@
@if ( Model.Id.HasValue )
{
    <h1>Muuda kursust</h1>
}
else
{
    <h1>Loo uus kursus</h1>
}

<div class="content-form">
    <form method="post" enctype="multipart/form-data" class="d-flex flex-column gap-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input id="CU_LanguageCourse_Guid" asp-for="Id" type="hidden"/>
        <input asp-for="CreatedAt" type="hidden"/>
        <input asp-for="ModifiedAt" type="hidden"/>
        <input asp-for="ModifiedBy" type="hidden"/>

        <div class="form-group">
            <label asp-for="Nimetus" class="form-label">Nimetus</label>
            <input id="CU_LanguageCourse_Nimetus" asp-for="Nimetus" class="form-control"/>
            <span asp-validation-for="Nimetus" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Keel" class="form-label">Keel</label>
            <input id="CU_LanguageCourse_Keel" asp-for="Keel" class="form-control"/>
            <span asp-validation-for="Keel" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Tase" class="form-label">Tase</label>
            <input id="CU_LanguageCourse_Tase" asp-for="Tase" class="form-control"/>
            <span asp-validation-for="Tase" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Kirjeldus" class="form-label">Kirjeldus</label>
            <input id="CU_LanguageCourse_Kirjeldus" asp-for="Kirjeldus" class="form-control"/>
            <span asp-validation-for="Kirjeldus" class="text-danger"></span>
        </div>

        @* create only, later add update, checkforid *@

        <div class="d-flex flex-wrap gap-2 border-top pt-3">
            @if ( Model.Id.HasValue )
            {
                <input asp-action="update"
                       asp-controller="LanguageCourses"
                       id="CU_Update_Btn"
                       type="submit"
                       value="Muuda"
                       class="btn btn-success"/>
            }
            else
            {
                <input asp-action="create"
                       asp-controller="LanguageCourses"
                       id="CU_Create_Btn"
                       type="submit"
                       value="Tee uus"
                       class="btn btn-success"/>
            }

            <a id="CU_Back_Btn" asp-action="Index" asp-controller="LanguageCourses" class="btn btn-secondary">Tagasi</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync( "_ValidationScriptsPartial" ); }
}