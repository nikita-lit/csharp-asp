@model School2.Models.LanguageCourses.LanguageCourseCreateUpdateViewModel

@* seperate update create *@
@if (Model.Id.HasValue)
{
    <h1>Muuda kursust</h1>
}
else
{
    <h1>Loo uus kursust</h1>
}

<div>
    <form method="post" enctype="multipart/form-data">
        <div asp-validation summary="ModelOnly" class="text-danger"></div>
        
        <input asp-for="Id" type="hidden"/>
        <input asp-for="CreatedAt" type="hidden"/>
        <input asp-for="ModifiedAt" type="hidden"/>
        <input asp-for="ModifiedBy" type="hidden"/>
        
        <div class="form-group">
            <label asp-for="Nimetus" class="control-label"></label>
            <input asp-for="Nimetus" class="form-control"/>
            <span asp-validation-for="Nimetus" class="text-danger"></span>
        </div>        
        
        <div class="form-group">
            <label asp-for="Keel" class="control-label"></label>
            <input asp-for="Keel" class="form-control"/>
            <span asp-validation-for="Keel" class="text-danger"></span>
        </div>        
        
        <div class="form-group">
            <label asp-for="Tase" class="control-label"></label>
            <input asp-for="Tase" class="form-control"/>
            <span asp-validation-for="Tase" class="text-danger"></span>
        </div>        
        
        <div class="form-group">
            <label asp-for="Kirjeldus" class="control-label"></label>
            <input asp-for="Kirjeldus" class="form-control"/>
            <span asp-validation-for="Kirjeldus" class="text-danger"></span>
        </div>
        
        @* create only, later add update, checkforid *@
        
        @if (Model.Id.HasValue)
        {
            <input asp-action="update" 
                   asp-controller="LanguageCourses" 
                   type="submit" 
                   value="Muuda"
                   class="btn btn-success"/>
        }
        else
        {
            <input asp-action="create" 
                   asp-controller="LanguageCourses" 
                   type="submit" 
                   value="Tee uus"
                   class="btn btn-success"/>
        }
        
        <a asp-action="Index" asp-controller="LanguageCourses" class="btn btn-secondary">Tagasi</a>
    </form>
</div>
