@model School2.Models.Students.StudentViewModel

@if ( Model.Id.HasValue )
{
    <h1>Muuda õpilast</h1>
}
else
{
    <h1>Loo uus õpilane</h1>
}

<div class="content-form">
    <form method="post" enctype="multipart/form-data" class="d-flex flex-column gap-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input id="CU_Student_Guid" asp-for="Id" type="hidden"/>
        <input asp-for="CreatedAt" type="hidden"/>
        <input asp-for="ModifiedAt" type="hidden"/>

        <div class="form-group">
            <label asp-for="FirstName" class="form-label">Eesnimi</label>
            <input id="CU_Student_FirstName" asp-for="FirstName" class="form-control"/>
            <span id="CU_Student_FirstName_Error" asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName" class="form-label">Perekonnanimi</label>
            <input id="CU_Student_LastName" asp-for="LastName" class="form-control"/>
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="PhoneNumber" class="form-label">Telefoninumber</label>
            <input id="CU_Student_PhoneNumber" asp-for="PhoneNumber" class="form-control"/>
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">E-post</label>
            <input id="CU_Student_Email" asp-for="Email" class="form-control"/>
            <span id="CU_Student_Email_Error" asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="d-flex flex-wrap gap-2 border-top pt-3">
            @if ( Model.Id.HasValue )
            {
                <input asp-action="update"
                       asp-controller="Students"
                       id="CU_Update_Btn"
                       type="submit"
                       value="Muuda"
                       class="btn btn-success"/>
            }
            else
            {
                <input asp-action="create"
                       asp-controller="Students"
                       id="CU_Create_Btn"
                       type="submit"
                       value="Tee uus"
                       class="btn btn-success"/>
            }

            <a id="CU_Back_Btn" asp-action="Index" asp-controller="Students" class="btn btn-secondary">Tagasi</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync( "_ValidationScriptsPartial" ); }
}