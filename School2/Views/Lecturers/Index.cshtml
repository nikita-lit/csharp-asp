@model IEnumerable<School2.Models.Lecturers.LecturerViewModel>

@{
    int rowNumber = 1;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <h1 class="mb-0">Õppejõud</h1>
    <a id="IndexCreateNewLecturer_Btn" asp-action="Create" asp-controller="Lecturers"
       class="btn btn-success">Lisa uus õppejõud</a>
</div>

<div class="table-responsive">
    <table id="IndexCreateNewLecturer_Table" class="table table-hover align-middle">
        <thead>
        <tr>
            <th scope="col">Nr</th>
            <th scope="col">Eesnimi</th>
            <th scope="col">Perekonnanimi</th>
            <th scope="col">Kvalifikatsioon</th>
            <th scope="col">Foto</th>
            <th scope="col" class="text-end">Tegevused</th>
        </tr>
        </thead>

        <tbody>
        @foreach ( var lecturer in Model )
        {
            <tr>
                <td>@rowNumber</td>

                <td id="IndexTableLecturer_FirstName">
                    @lecturer.FirstName
                </td>

                <td id="IndexTableLecturer_LastName">
                    @lecturer.LastName
                </td>

                <td id="IndexTableLecturer_Qualifications">
                    @lecturer.Qualifications
                </td>

                <td>
                    @if (lecturer.ImageId.HasValue)
                    {
                        <img src="@Url.Action( "Image", "Lecturers", new { id = lecturer.ImageId } )"
                             alt="Õppejõu foto" class="lecturer-photo lecturer-thumbnail"/>
                    }
                    else
                    {
                        <span class="text-muted">Foto puudub</span>
                    }
                </td>

                <td id="IndexTableLecturer_Actions">
                    <div class="d-flex justify-content-end gap-2">
                        <a id="IndexTableLecturerDetails_Btn"
                           asp-action="Details"
                           asp-controller="Lecturers"
                           asp-route-id="@lecturer.Id"
                           class="btn btn-secondary">
                            Andmed
                        </a>

                        <a id="IndexTableLecturerUpdate_Btn"
                           asp-action="Update"
                           asp-controller="Lecturers"
                           asp-route-id="@lecturer.Id"
                           class="btn btn-warning">
                            Muuda
                        </a>

                        <a id="IndexTableLecturerDelete_Btn"
                           asp-action="Delete"
                           asp-controller="Lecturers"
                           asp-route-id="@lecturer.Id"
                           class="btn btn-danger">
                            Kustuta
                        </a>
                    </div>
                </td>
            </tr>

            rowNumber++;
        }
        </tbody>
    </table>
</div>
